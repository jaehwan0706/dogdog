spring:
  datasource:
    url: jdbc:mysql://localhost:3306/dangsanchaek?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
    username: root
    password: changeme
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
  flyway:
    enabled: true
    locations: classpath:db/migration,classpath:db/seed

server:
  port: 8080

app:
  jwt:
    secret: local-dev-secret-change-me-0123456789-abcdefghij
  oauth:
    mock-enabled: true
  payment:
    mode: mock
  admin:
    emails: admin@dangsanchaek.dev
